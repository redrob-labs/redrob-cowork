FROM node:22-bookworm-slim AS openwork-builder

WORKDIR /src

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git unzip \
  && npm install -g bun \
  && corepack enable \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN pnpm install --frozen-lockfile --trust-lockfile --filter redrob-server... \
  && pnpm --filter redrob-server build \
  && pnpm --filter redrob-server build:bin

FROM node:22-bookworm-slim

ARG REDROB_SERVER_VERSION
ARG REDROB_CODE_VERSION
ARG REDROB_CODE_GITHUB_REPO=redrob-labs/redrob-code
ARG REDROB_CODE_DOWNLOAD_URL=

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl tar unzip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=openwork-builder /src/apps/server/dist/bin/redrob-server /usr/local/bin/redrob-server
COPY --from=openwork-builder /src/apps/server/dist/opencode-plugins /opt/redrob/opencode-plugins
COPY --from=openwork-builder /src/constants.json /usr/local/constants.json
COPY packaging/docker/microsandbox-entrypoint.sh /usr/local/bin/microsandbox-entrypoint.sh

# redrob-labs/redrob-code is private, so the archive is resolved through the
# authenticated Releases API by asset id. Pass the token as a BuildKit secret
# (`--secret id=redrob_github_token,env=REDROB_GITHUB_TOKEN`) so it never lands
# in an image layer, or set REDROB_CODE_DOWNLOAD_URL for a mirror.
RUN --mount=type=secret,id=redrob_github_token \
  set -eu; \
  test -n "$REDROB_SERVER_VERSION"; \
  test -n "$REDROB_CODE_VERSION"; \
  arch="$(dpkg --print-architecture)"; \
  case "$arch" in \
    amd64) asset="redrob-linux-x64-baseline.tar.gz" ;; \
    arm64) asset="redrob-linux-arm64.tar.gz" ;; \
    *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
  esac; \
  tmpdir="$(mktemp -d)"; \
  if [ -n "$REDROB_CODE_DOWNLOAD_URL" ]; then \
    curl -fsSL "$REDROB_CODE_DOWNLOAD_URL" -o "$tmpdir/$asset"; \
  else \
    if [ ! -s /run/secrets/redrob_github_token ]; then \
      echo "Cannot download the Redrob Code engine: ${REDROB_CODE_GITHUB_REPO} is private and no token was mounted." >&2; \
      echo "Build with --secret id=redrob_github_token,env=REDROB_GITHUB_TOKEN or set REDROB_CODE_DOWNLOAD_URL." >&2; \
      exit 1; \
    fi; \
    api="https://api.github.com/repos/${REDROB_CODE_GITHUB_REPO}/releases"; \
    curl -fsSL -H "Authorization: Bearer $(cat /run/secrets/redrob_github_token)" \
      -H "Accept: application/vnd.github+json" \
      "$api/tags/v${REDROB_CODE_VERSION}" -o "$tmpdir/release.json"; \
    asset_id="$(node -e 'const r=require(process.argv[1]);const a=(r.assets||[]).find((x)=>x.name===process.argv[2]);if(!a){console.error(`${process.argv[2]} is not attached to the release`);process.exit(1);}process.stdout.write(String(a.id));' "$tmpdir/release.json" "$asset")"; \
    curl -fsSL -H "Authorization: Bearer $(cat /run/secrets/redrob_github_token)" \
      -H "Accept: application/octet-stream" \
      "$api/assets/${asset_id}" -o "$tmpdir/$asset"; \
  fi; \
  tar -xzf "$tmpdir/$asset" -C "$tmpdir"; \
  binary="$(find "$tmpdir" -type f -name redrob | head -n 1)"; \
  test -n "$binary"; \
  install -m 0755 "$binary" /usr/local/bin/redrob; \
  chmod +x /usr/local/bin/microsandbox-entrypoint.sh; \
  rm -rf "$tmpdir"

RUN test -f /opt/redrob/opencode-plugins/redrob-extensions-preview.js \
  && test -f /opt/redrob/opencode-plugins/redrob-capabilities-knowledge.js \
  && test -f /opt/redrob/opencode-plugins/redrob-office-attachments.js \
  && test -f /opt/redrob/opencode-plugins/redrob-anthropic-adaptive-thinking.js \
  && test -f /opt/redrob/opencode-plugins/redrob-anthropic-tool-schema.js \
  && test "$(redrob-server --version)" = "$REDROB_SERVER_VERSION" \
  && redrob --version

ENV REDROB_EXTENSIONS_PLUGIN_DIR=/opt/redrob/opencode-plugins
ENV REDROB_DATA_DIR=/data/redrob-server
ENV REDROB_SIDECAR_DIR=/data/sidecars
ENV REDROB_WORKSPACE=/workspace

EXPOSE 8787

VOLUME ["/workspace", "/data"]

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=12 \
  CMD /bin/sh -c 'curl -fsS "http://127.0.0.1:${REDROB_PORT:-8787}/health" >/dev/null || exit 1'

ENTRYPOINT ["/usr/local/bin/microsandbox-entrypoint.sh"]
