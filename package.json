{
  "name": "@redrob/workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "REDROB_DEV_MODE=1 REDROB_ELECTRON_REMOTE_DEBUG_PORT=${REDROB_ELECTRON_REMOTE_DEBUG_PORT:-9823} pnpm --filter @redrob/desktop dev",
    "dev:worktree": "REDROB_DEV_MODE=1 REDROB_DEV_PROFILE=auto REDROB_ELECTRON_USE_MOCK_KEYCHAIN=${REDROB_ELECTRON_USE_MOCK_KEYCHAIN:-1} REDROB_ELECTRON_REMOTE_DEBUG_PORT=0 PORT=0 pnpm --filter @redrob/desktop dev",
    "dev:electron": "REDROB_DEV_MODE=1 pnpm --filter @redrob/desktop dev:electron",
    "dev:electron:two": "REDROB_DEV_MODE=1 node scripts/dev-two-electron-demo.mjs",
    "demo:electron": "REDROB_DEV_MODE=1 node scripts/dev-two-electron-demo.mjs --reset",
    "demo:electron:build": "node scripts/build-two-electron-demo.mjs",
    "demo:electron:reset": "node scripts/dev-two-electron-demo.mjs --reset-only",
    "dev:ui": "REDROB_DEV_MODE=1 pnpm --filter @redrob/app dev",
    "build": "node scripts/build.mjs",
    "build:ui": "pnpm --filter @redrob/app build",
    "preview": "pnpm --filter @redrob/app preview",
    "typecheck": "pnpm --filter @redrob/app typecheck",
    "check:enterprise-mcp-mock-server": "pnpm --filter @redrob/enterprise-mcp-mock-server check",
    "test": "pnpm -r --if-present run test",
    "test:health": "pnpm --filter @redrob/app test:health",
    "test:sessions": "pnpm --filter @redrob/app test:sessions",
    "test:refactor": "pnpm --filter @redrob/app test:refactor",
    "test:events": "pnpm --filter @redrob/app test:events",
    "test:todos": "pnpm --filter @redrob/app test:todos",
    "test:permissions": "pnpm --filter @redrob/app test:permissions",
    "test:session-error-recovery": "pnpm --filter @redrob/app test:session-error-recovery",
    "test:session-scope": "pnpm --filter @redrob/app test:session-scope",
    "test:session-switch": "pnpm --filter @redrob/app test:session-switch",
    "test:fs-engine": "pnpm --filter @redrob/app test:fs-engine",
    "check:outbound-access": "node scripts/check-outbound-access.mjs",
    "test:e2e": "pnpm --filter @redrob/app test:e2e",
    "release:review": "node scripts/release/review.mjs",
    "release:rollback": "node scripts/release/rollback.mjs",
    "release:cut": "node scripts/release/cut.mjs",
    "release:cut:watch": "node scripts/release/cut.mjs --watch"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "turbo": "^2.10.7",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.4.0"
}
