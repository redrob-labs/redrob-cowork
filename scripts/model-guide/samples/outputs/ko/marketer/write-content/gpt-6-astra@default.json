매장 개념 일러스트입니다.\n  </desc>\n\n  <rect width=\"1200\" height=\"630\" fill=\"#F7F5F0\"/>\n\n  <g font-family=\"Pretendard, sans-serif\" fill=\"#1F4D3A\">\n    <text x=\"56\" y=\"53\" font-size=\"19\" font-weight=\"600\">\n      써멀린 프로 · 2025년 12월 1일 출시\n    </text>\n\n    <text x=\"56\" y=\"124\" font-size=\"46\" font-weight=\"750\">\n      냉난방 스케줄은 자동으로\n    </text>\n\n    <text x=\"56\" y=\"173\" font-size=\"21\">\n      <tspan x=\"56\">영업시간 학습 스케줄,</tspan>\n      <tspan x=\"56\" dy=\"31\">직원은 설정 온도 ±1°C 이내, 가동 중 문 열림 알림.</tspan>\n    </text>\n\n    <rect x=\"56\" y=\"237\" width=\"5\" height=\"28\" rx=\"2\" fill=\"#F2A93B\"/>\n    <text x=\"73\" y=\"259\" font-size=\"22\" font-weight=\"650\">\n      냉난방 에너지 사용량 중앙값 18% 감소*\n    </text>\n\n    <text x=\"56\" y=\"320\" font-size=\"30\" font-weight=\"750\">\n      출시 기념가 199,000원\n    </text>\n    <text x=\"56\" y=\"350\" font-size=\"18\">\n      2026년 1월 31일까지 · 정가 239,000원\n    </text>\n    <text x=\"56\" y=\"387\" font-size=\"21\" font-weight=\"600\">\n      스케줄·알림 필수 구독: 매장당 월 9,900원\n    </text>\n\n    <!-- 단일 CTA -->\n    <g role=\"button\" aria-label=\"써멀린 프로 구매하기\">\n      <rect x=\"56\" y=\"418\" width=\"268\" height=\"60\" rx=\"10\" fill=\"#F2A93B\"/>\n      <text x=\"190\" y=\"456\" text-anchor=\"middle\"\n            font-size=\"23\" font-weight=\"750\">\n        써멀린 프로 구매하기\n      </text>\n    </g>\n  </g>\n\n  <!-- 제품 외형이나 실제 UI가 아닌 기능 개념 일러스트 -->\n  <g aria-hidden=\"true\">\n    <rect x=\"777\" y=\"76\" width=\"367\" height=\"410\" rx=\"28\"\n          fill=\"#1F4D3A\" fill-opacity=\"0.06\"/>\n\n    <!-- 매장 -->\n    <rect x=\"817\" y=\"233\" width=\"285\" height=\"205\" rx=\"8\"\n          fill=\"#F7F5F0\" stroke=\"#1F4D3A\" stroke-width=\"4\"/>\n    <path d=\"M807 233 L833 185 H1086 L1112 233 Z\"\n          fill=\"#1F4D3A\"/>\n    <path d=\"M839 185 L831 233 M888 185 L884 233\n             M938 185 V233 M988 185 L992 233 M1038 185 L1047 233\"\n          stroke=\"#F7F5F0\" stroke-width=\"4\" opacity=\"0.